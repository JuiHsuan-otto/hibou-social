  },
  {
    "id": "2026-11-08-evening-owl-ep03-s3",
    "slot": "evening",
    "publish_at": "2026-11-08T20:00:00+08:00",
    "media_type": "VIDEO",
    "text": "禮盒一打開，大家各看各的。\n有人看花色，有人研究紗布巾，有人急著唸卡片。\n花色可以等，卡片上那幾句先唸完。\n你收過哪一句彌月祝福，到現在還記得？",
    "image_url": null,
    "image_sha256": null,
    "video_url": "https://raw.githubusercontent.com/JuiHsuan-otto/hibou-social/main/social/videos/2026/owl_shorts/ep03_s3.mp4",
